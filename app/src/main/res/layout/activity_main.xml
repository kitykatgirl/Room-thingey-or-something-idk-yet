<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:background="#C43434"
        android:layout_height="300sp"
        app:srcCompat="@drawable/cid_7a4399fcfcb8615f" />

    <EditText
        android:id="@+id/editTextNazwa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5sp"
        android:ems="10"
        android:inputType="text"
        android:hint="Nazwa gry" />

    <EditText
        android:id="@+id/editTextMinOsob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5sp"
        android:ems="10"
        android:inputType="number"
        android:hint="Minimalna liczba osob" />

    <EditText
        android:id="@+id/editTextMaxOsob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5sp"
        android:ems="10"
        android:inputType="number"
        android:hint="Maksymalna liczba osob" />

    <EditText
        android:id="@+id/editTextKatWiekowa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5sp"
        android:ems="10"
        android:inputType="number"
        android:hint="Kategoria Wiekowa" />

    <Spinner
        android:id="@+id/spinnerKategoria"
        android:layout_width="match_parent"
        android:entries="@array/kategorie"
        android:layout_margin="5sp"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5sp"
        android:text="Dodaj" />

    <Button
        android:id="@+id/button2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5sp"
        android:visibility="gone"
        android:text="Aktualizuj" />

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>